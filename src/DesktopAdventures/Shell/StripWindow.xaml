<Window x:Class="DesktopAdventures.Shell.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Adventures"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="100" Height="100"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Nur die gezeichneten (deckenden) Pixel fangen Klicks ab, transparente Bereiche
         lässt Windows durch. Rechtsklick auf die Landschaft: Beenden. -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Beenden" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Image x:Name="View"
           Stretch="Fill"
           HorizontalAlignment="Left"
           VerticalAlignment="Bottom"
           RenderOptions.BitmapScalingMode="NearestNeighbor"
           RenderOptions.EdgeMode="Aliased" />
</Window>
